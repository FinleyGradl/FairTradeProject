// path: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma/client"
}


datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  owner
  moderator
  admin
}

enum StoreStatus {
  pending
  active
  rejected
  closed
}

enum ReviewStatus {
  published
  hidden
  flagged
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum VerificationLevel {
  unverified
  community
  admin
}

enum AttestationVote {
  confirm
  dispute
}

enum SponsorshipTier {
  basic
  plus
  top
}

enum SponsorshipStatus {
  incomplete // first (mandate) payment created at Mollie, not confirmed yet
  active
  past_due // renewal payment failed, Mollie will retry
  canceled
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  pendingEmail  String?   @unique
  password      String?
  name          String?
  avatarUrl     String?
  role          UserRole  @default(user)
  // Community-moderation reputation. Grows with approved/community-verified
  // submissions and shrinks on rejections/upheld reports — see
  // TRUST_SCORE_DELTAS in lib/trust.ts for the concrete point values.
  trustScore    Int       @default(0)
  createdAt     DateTime  @default(now())

  storesCreated Store[]      @relation("StoreCreator")
  storesOwned   Store[]      @relation("StoreOwner")
  reviews       Review[]
  savedStores   SavedStore[]
  savedProducts SavedProduct[]
  claims        StoreClaim[]
  claimsReviewed StoreClaim[] @relation("ClaimReviewer")
  attestations  StoreAttestation[]
  sponsorships  SponsorshipSubscription[]
  promoCodesCreated PromoCode[]

  accounts             Account[]
  sessions             Session[]
  emailVerifyTokens    EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
}

// --- Auth.js (NextAuth) required models for the Google OAuth adapter ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Custom flows: email verification & forgot-password ---
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String
  addressLine  String
  city         String
  postalCode   String
  country      String      @default("DE")
  latitude     Float
  longitude    Float
  phone        String?
  website      String?
  email        String?
  ownerUserId  String?
  status       StoreStatus @default(active)
  fairBadges   String      @default("[]")
  categories   String      @default("[]")
  coverImage   String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Community-verification state — see lib/attestations.ts for the
  // threshold logic that moves a store between these.
  verificationLevel VerificationLevel @default(unverified)
  confirmCount       Int              @default(0)
  disputeCount        Int              @default(0)

  owner     User?        @relation("StoreOwner", fields: [ownerUserId], references: [id])
  createdBy User         @relation("StoreCreator", fields: [createdById], references: [id])
  hours     StoreHours[]
  products  Product[]
  reviews   Review[]
  savedBy   SavedStore[]
  claims    StoreClaim[]
  photos    StorePhoto[]
  attestations StoreAttestation[]
  sponsorships SponsorshipSubscription[]
  pageViews    PageView[]
  searchImpressions SearchImpression[]
}

// --- Sponsoring (paid preferred placement) ----------------------------------

// Admin-managed discount/promo codes for sponsorship checkout. Complements
// (but doesn't replace) the hardcoded dev-only code in lib/promo-codes.ts.
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  label           String?
  active          Boolean   @default(true)
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([code])
}

model SponsorshipSubscription {
  id          String            @id @default(cuid())
  storeId     String
  ownerUserId String
  tier        SponsorshipTier
  status      SponsorshipStatus @default(incomplete)

  // Mollie references. The "first" payment establishes a mandate; once it's
  // paid we create a recurring Mollie subscription and store its id here.
  // See lib/mollie.ts + app/api/webhooks/mollie/route.ts.
  mollieCustomerId     String?
  mollieSubscriptionId String?
  molliePaymentId      String?

  // Optional dev/promo code redeemed at checkout (see lib/promo-codes.ts).
  // A 100%-off code skips Mollie entirely; partial discounts reduce the
  // amount sent to Mollie. Kept for audit purposes even after redemption.
  promoCode       String?
  discountPercent Int     @default(0)

  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@index([mollieSubscriptionId])
}

// --- Analytics / Insights ----------------------------------------------------
// Deliberately minimal & privacy-conscious: no raw IP addresses are stored,
// no cross-day tracking identifiers. See lib/analytics.ts for how
// `visitorHash` is derived (daily-rotating salted hash) and lib/geo-ip.ts for
// the best-effort, header-first country lookup.

model PageView {
  id           String   @id @default(cuid())
  storeId      String
  path         String
  referrerUrl  String?
  referrerHost String?
  country      String?
  visitorHash  String
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model SearchImpression {
  id        String   @id @default(cuid())
  storeId   String
  query     String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model StoreAttestation {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  vote      AttestationVote
  reason    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per person per store — casting again updates the existing row
  // rather than creating a second one.
  @@unique([storeId, userId])
}

model StoreHours {
  id        String  @id @default(cuid())
  storeId   String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  price       Float?
  currency    String   @default("EUR")
  category    String?
  imageUrl    String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  savedBy   SavedProduct[]

  @@unique([storeId, slug])
}

model Review {
  id           String       @id @default(cuid())
  storeId      String
  userId       String
  rating       Int
  title        String?
  body         String
  ownerReply   String?
  ownerReplyAt DateTime?
  status       ReviewStatus @default(published)
  createdAt    DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

model SavedStore {
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model SavedProduct {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model StoreClaim {
  id         String      @id @default(cuid())
  storeId    String
  userId     String
  proofText  String
  proofDocs  String?
  status     ClaimStatus @default(pending)
  reviewedBy String?
  createdAt  DateTime    @default(now())

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ClaimReviewer", fields: [reviewedBy], references: [id])
}

model StorePhoto {
  id        String @id @default(cuid())
  storeId   String
  url       String
  caption   String?
  sortOrder Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
