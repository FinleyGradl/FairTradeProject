// prisma/schema.prisma
// path: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma/client"
}


datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  owner
  moderator
  admin
}

enum StoreStatus {
  pending
  active
  rejected
  closed
}

enum ReviewStatus {
  published
  hidden
  flagged
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum VerificationLevel {
  unverified
  community
  admin
}

enum AttestationVote {
  confirm
  dispute
}

enum EditSuggestionStatus {
  pending
  approved
  rejected
}

enum SponsorshipTier {
  basic
  plus
  top
}

enum SponsorshipStatus {
  incomplete // first (mandate) payment created at Mollie, not confirmed yet
  active
  past_due // renewal payment failed, Mollie will retry
  canceled
}

enum OwnershipTransferStatus {
  pending
  accepted
  declined
  canceled // superseded by a newer invite, or canceled by the sender
  expired
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  pendingEmail  String?   @unique
  password      String?
  name          String?
  avatarUrl     String?
  role          UserRole  @default(user)
  // A superuser can manage other users' roles (promote/demote to
  // admin/moderator) via /admin/users — a level of trust above plain
  // "admin", which by itself does NOT grant user-management rights. There
  // is no UI to grant the first superuser; it must be set directly in the
  // DB (or via prisma/seed.ts) to bootstrap the very first one.
  isSuperuser   Boolean   @default(false)
  // Community-moderation reputation. Grows with approved/community-verified
  // submissions and shrinks on rejections/upheld reports — see
  // TRUST_SCORE_DELTAS in lib/trust.ts for the concrete point values.
  trustScore    Int       @default(0)
  createdAt     DateTime  @default(now())

  storesCreated Store[]      @relation("StoreCreator")
  storesOwned   Store[]      @relation("StoreOwner")
  reviews       Review[]
  savedStores   SavedStore[]
  savedProducts SavedProduct[]
  claims        StoreClaim[]
  claimsReviewed StoreClaim[] @relation("ClaimReviewer")
  attestations  StoreAttestation[]
  editSuggestions       StoreEditSuggestion[]     @relation("SuggestionAuthor")
  editSuggestionsReviewed StoreEditSuggestion[]   @relation("SuggestionReviewer")
  editSuggestionVotes   EditSuggestionVote[]
  sponsorships  SponsorshipSubscription[]
  promoCodesCreated PromoCode[]
  photosUploaded    StorePhoto[]   @relation("PhotoUploader")
  photoReports      PhotoReport[]
  reviewReports     ReviewReport[]
  transfersSent     OwnershipTransfer[] @relation("TransferSender")
  transfersReceived OwnershipTransfer[] @relation("TransferRecipient")
  auditLogs         AuditLog[]          @relation("AuditActor")
  notificationPreference NotificationPreference?

  accounts             Account[]
  sessions             Session[]
  emailVerifyTokens    EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
}

// --- Auth.js (NextAuth) required models for the Google OAuth adapter ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Custom flows: email verification & forgot-password ---
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String
  addressLine  String
  city         String
  postalCode   String
  country      String      @default("DE")
  latitude     Float
  longitude    Float
  phone        String?
  website      String?
  email        String?
  ownerUserId  String?
  status       StoreStatus @default(active)
  fairBadges   String      @default("[]")
  categories   String      @default("[]")
  coverImage   String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Community-verification state — see lib/attestations.ts for the
  // threshold logic that moves a store between these.
  verificationLevel VerificationLevel @default(unverified)
  confirmCount       Int              @default(0)
  disputeCount        Int              @default(0)

  owner     User?        @relation("StoreOwner", fields: [ownerUserId], references: [id])
  createdBy User         @relation("StoreCreator", fields: [createdById], references: [id])
  hours     StoreHours[]
  products  Product[]
  reviews   Review[]
  savedBy   SavedStore[]
  claims    StoreClaim[]
  photos    StorePhoto[]
  attestations StoreAttestation[]
  editSuggestions StoreEditSuggestion[]
  sponsorships SponsorshipSubscription[]
  pageViews    PageView[]
  searchImpressions SearchImpression[]
  ownershipTransfers OwnershipTransfer[]
}

// --- Community-suggested edits ----------------------------------------------
// The "suggest an edit" flow (à la Google Business Profile): any signed-in
// user who is not already allowed to edit a store directly (see
// canEditStore()) can propose a set of field changes instead of editing
// nothing at all. What happens to the suggestion depends on whether the
// store is "managed" (has a confirmed ownerUserId):
//   - Managed:   only that owner (or an admin/moderator) can review it —
//                see reviewEditSuggestion() in lib/edit-suggestions.ts.
//   - Unmanaged: it's surfaced in the admin moderation queue AND opened up
//                to community confirm/dispute votes (see castSuggestionVote())
//                — whichever resolves first (an admin decision, or enough
//                net votes) applies or discards it.
// `changes` holds only the fields that differ from the store's current
// values at submission time, as JSON: { fieldName: newValue }. Diffs are
// rendered by comparing this against the store's *current* values at
// review time (not a frozen snapshot), so a suggestion never goes stale
// even if the store changed in the meantime.
model StoreEditSuggestion {
  id                String               @id @default(cuid())
  storeId           String
  suggestedByUserId String
  changes           String
  note              String?
  status            EditSuggestionStatus @default(pending)
  confirmCount      Int                  @default(0)
  disputeCount      Int                  @default(0)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  suggestedBy User                 @relation("SuggestionAuthor", fields: [suggestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?                @relation("SuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  votes       EditSuggestionVote[]

  @@index([storeId, status])
}

// Community confirm/dispute votes on a pending suggestion for an unmanaged
// store — same one-vote-per-person shape as StoreAttestation.
model EditSuggestionVote {
  id           String          @id @default(cuid())
  suggestionId String
  userId       String
  vote         AttestationVote
  createdAt    DateTime        @default(now())

  suggestion StoreEditSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

// --- Sponsoring (paid preferred placement) ----------------------------------

// Admin-managed discount/promo codes for sponsorship checkout. Complements
// (but doesn't replace) the hardcoded dev-only code in lib/promo-codes.ts.
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  label           String?
  active          Boolean   @default(true)
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([code])
}

model SponsorshipSubscription {
  id          String            @id @default(cuid())
  storeId     String
  ownerUserId String
  tier        SponsorshipTier
  status      SponsorshipStatus @default(incomplete)

  // Mollie references. The "first" payment establishes a mandate; once it's
  // paid we create a recurring Mollie subscription and store its id here.
  // See lib/mollie.ts + app/api/webhooks/mollie/route.ts.
  mollieCustomerId     String?
  mollieSubscriptionId String?
  molliePaymentId      String?

  // Optional dev/promo code redeemed at checkout (see lib/promo-codes.ts).
  // A 100%-off code skips Mollie entirely; partial discounts reduce the
  // amount sent to Mollie. Kept for audit purposes even after redemption.
  promoCode       String?
  discountPercent Int     @default(0)

  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([storeId])
  @@index([status])
  @@index([mollieSubscriptionId])
}

// --- Ownership transfer (succession) ----------------------------------------
// A two-step handover: the current owner invites an already-registered user
// by email; nothing changes until that person actively accepts (see
// lib/ownership-transfer.ts). At most one "pending" invite exists per store
// at a time — starting a new one supersedes the previous. Any active
// sponsorship is canceled as part of accepting a transfer (a new owner
// starts their own, if they want one).
model OwnershipTransfer {
  id          String                   @id @default(cuid())
  storeId     String
  fromUserId  String
  toUserId    String
  token       String                   @unique
  message     String?
  status      OwnershipTransferStatus  @default(pending)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime                 @default(now())

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromUser User  @relation("TransferSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("TransferRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([toUserId, status])
}

// --- Analytics / Insights ----------------------------------------------------
// Deliberately minimal & privacy-conscious: no raw IP addresses are stored,
// no cross-day tracking identifiers. See lib/analytics.ts for how
// `visitorHash` is derived (daily-rotating salted hash) and lib/geo-ip.ts for
// the best-effort, header-first country lookup.

model PageView {
  id           String   @id @default(cuid())
  storeId      String
  path         String
  referrerUrl  String?
  referrerHost String?
  country      String?
  visitorHash  String
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model SearchImpression {
  id        String   @id @default(cuid())
  storeId   String
  query     String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model StoreAttestation {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  vote      AttestationVote
  reason    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per person per store — casting again updates the existing row
  // rather than creating a second one.
  @@unique([storeId, userId])
}

model StoreHours {
  id        String  @id @default(cuid())
  storeId   String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  price       Float?
  currency    String   @default("EUR")
  category    String?
  imageUrl    String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  savedBy   SavedProduct[]

  @@unique([storeId, slug])
}

model Review {
  id           String       @id @default(cuid())
  storeId      String
  userId       String
  rating       Int
  title        String?
  body         String
  ownerReply   String?
  ownerReplyAt DateTime?
  status       ReviewStatus @default(published)
  createdAt    DateTime     @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ReviewReport[]

  @@unique([storeId, userId])
}

// Community reporting for reviews. One report per person per review
// (re-reporting just no-ops) — see REVIEW_REPORT_THRESHOLD in
// lib/constants.ts for the count that surfaces a review in the admin
// moderation queue. Reaching the threshold does NOT hide the review
// automatically; it only makes it visible to admins/moderators, who can
// then hide it (status -> "hidden") or dismiss the reports.
model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model SavedStore {
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model SavedProduct {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model StoreClaim {
  id         String      @id @default(cuid())
  storeId    String
  userId     String
  proofText  String
  proofDocs  String?
  status     ClaimStatus @default(pending)
  reviewedBy String?
  createdAt  DateTime    @default(now())

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ClaimReviewer", fields: [reviewedBy], references: [id])
}

model StorePhoto {
  id               String   @id @default(cuid())
  storeId          String
  url              String
  caption          String?
  sortOrder        Int      @default(0)
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation("PhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reports    PhotoReport[]

  @@index([storeId])
}

// Community reporting for user-uploaded gallery photos. One report per
// person per photo (re-reporting just no-ops) — see PHOTO_REPORT_THRESHOLD
// in lib/constants.ts for the count that surfaces a photo in the admin
// moderation queue. Reaching the threshold does NOT auto-remove the photo;
// it only makes it visible to admins/moderators, who can then delete it.
model PhotoReport {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  photo StorePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([photoId])
}

// --- Audit log ----------------------------------------------------------
// Append-only trail of who edited/deleted/moderated what. Written via
// logAudit() in lib/audit.ts, which is fire-and-forget (a logging failure
// never blocks the underlying action). Actor fields are denormalized
// (snapshotted at write time) so entries stay meaningful even after the
// acting user's account is later deleted or renamed — see onDelete:
// SetNull on `actor` below.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorName  String?
  actorRole  String?
  // Dot-namespaced, e.g. "store.delete", "user.role_change" — see
  // AUDIT_ACTIONS in lib/audit.ts for the canonical list.
  action     String
  entityType String
  entityId   String?
  // Short human-readable label of the affected entity (store name, user
  // email, ...) so the log reads well without joining back to now-deleted
  // rows.
  entityLabel String?
  // Optional extra context as JSON, e.g. { "from": "user", "to": "admin" }
  // or { "reason": "..." }. Parsed with parseJsonObject() from lib/utils.
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// --- Notification preferences --------------------------------------------
// Per-user, per-category opt-in/-out for the moderation/sponsorship email
// notifications sent via lib/notify.ts. Only meaningful for admins/
// moderators (see getRecipientsForCategory in lib/notification-preferences.ts).
// A missing row is treated as "everything on" (the default), so ordinary
// users never need one and new admins/mods start out fully notified.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifyNewStoreReport  Boolean @default(true) // store flagged via community disputes
  notifyNewReviewReport Boolean @default(true)
  notifyNewPhotoReport  Boolean @default(true)
  notifyNewClaim        Boolean @default(true)
  notifyNewSuggestion   Boolean @default(true)

  notifySponsorshipStarted       Boolean @default(true)
  notifySponsorshipCanceled      Boolean @default(true)
  notifySponsorshipPaymentFailed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Billing / invoice settings (singleton) -------------------------------
// Superuser-managed under /admin/settings/billing. Single row keyed by the
// fixed id "default". Every issued Invoice snapshots these fields at
// creation time (see Invoice.issuerSnapshot) so a legally issued invoice
// never silently changes if these settings are edited afterwards.
model PlatformSettings {
  id String @id @default("default")

  invoiceIssuerName    String @default("FairTradeProject")
  invoiceIssuerStreet  String @default("")
  invoiceIssuerZipCity String @default("")
  invoiceIssuerCountry String @default("Deutschland")
  invoiceIssuerEmail   String @default("")

  invoiceIssuerTaxNumber String? // Steuernummer
  invoiceIssuerVatId     String? // USt-IdNr.

  // §19 UStG: no VAT is shown on invoices while this is true, regardless
  // of vatRatePercent below (kept around so switching to Regelbesteuerung
  // later doesn't require re-entering the rate).
  isKleinunternehmer Boolean @default(true)
  vatRatePercent     Int     @default(19)

  invoiceIssuerIban     String?
  invoiceIssuerBankName String?
  invoiceFooterNote     String?

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

// --- Invoices --------------------------------------------------------------
// One row per billed sponsorship payment (first payment + every recurring
// renewal) — see lib/invoices.ts. Immutable once created: amounts and the
// issuer's address/tax details are snapshotted at creation time, exactly
// as German invoice law (§14 UStG) requires — an invoice must not change
// retroactively just because platform settings changed later.
model Invoice {
  id             String @id @default(cuid())
  sequenceNumber Int    @unique @default(autoincrement())

  subscriptionId String
  subscription   SponsorshipSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  storeId  String
  storeName String // snapshot — the store could be renamed/deleted later

  recipientUserId String
  recipientName   String?
  recipientEmail  String

  tier        String
  periodStart DateTime
  periodEnd   DateTime

  amountNetCents     Int
  vatRatePercent     Int
  vatAmountCents     Int
  amountGrossCents   Int
  isKleinunternehmer Boolean

  // JSON snapshot of PlatformSettings' invoiceIssuer* fields at the moment
  // this invoice was created.
  issuerSnapshot String

  molliePaymentId String?
  createdAt       DateTime @default(now())

  @@index([subscriptionId])
  @@index([storeId])
  @@index([recipientUserId])
}
